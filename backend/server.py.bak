def calculate_anniversary_stats(anniversary_val, current_ts: float = None) -> dict:
    if current_ts is None:
        current_ts = time.time()

    if isinstance(anniversary_val, (int, float)):
        start_ts = float(anniversary_val)
        start_dt = datetime.fromtimestamp(start_ts, tz=timezone.utc)
    elif isinstance(anniversary_val, str) and anniversary_val.strip():
        val = anniversary_val.strip()
        try:
            if "T" in val:
                start_dt = datetime.fromisoformat(val.replace("Z", "+00:00"))
            else:
                parts = val.split("-")
                start_dt = datetime(int(parts[0]), int(parts[1]), int(parts[2]), 0, 0, 0, tzinfo=timezone.utc)
            start_ts = start_dt.timestamp()
        except Exception:
            start_ts = current_ts
            start_dt = datetime.fromtimestamp(start_ts, tz=timezone.utc)
    else:
        start_ts = current_ts
        start_dt = datetime.fromtimestamp(start_ts, tz=timezone.utc)

    end_dt = datetime.fromtimestamp(current_ts, tz=timezone.utc)
    is_future = current_ts < start_ts
    t0 = end_dt if is_future else start_dt
    t1 = start_dt if is_future else end_dt

    y = t1.year - t0.year
    p = add_months_clamped(t0, y * 12)
    if p > t1:
        y -= 1
        p = add_months_clamped(t0, y * 12)

    m = 0
    while True:
        next_p = add_months_clamped(p, 1)
        if next_p <= t1:
            m += 1
            p = next_p
        else:
            break

    rem_seconds = int((t1 - p).total_seconds())
    d = rem_seconds // 86400
    rem_seconds %= 86400
    h = rem_seconds // 3600
    rem_seconds %= 3600
    minute = rem_seconds // 60
    s = rem_seconds % 60

    total_seconds = max(0, int(abs(current_ts - start_ts)))
    total_days = max(1, total_seconds // 86400 + (0 if is_future else 1))
    total_hours = total_seconds // 3600

    milestones_list = []
    next_milestone = None
    prev_days = 0
    for m_def in RELATIONSHIP_MILESTONES:
        m_days = m_def["days"]
        completed = total_days >= m_days
        item = {
            "days": m_days,
            "title": m_def["title"],
            "badge": m_def["badge"],
            "icon": m_def["icon"],
            "desc": m_def["desc"],
            "completed": completed,
            "daysLeft": max(0, m_days - total_days)
        }
        milestones_list.append(item)
        if not completed and next_milestone is None:
            span = max(1, m_days - prev_days)
            elapsed_in_span = max(0, total_days - prev_days)
            item["progressPct"] = min(100.0, round((elapsed_in_span / span) * 100.0, 1))
            next_milestone = item
        if completed:
            prev_days = m_days

    if next_milestone is None:
        next_milestone = {
            "days": 1000,
            "title": "Легендарная любовь! 👑",
            "badge": "1000+ дней",
            "icon": "👑",
            "desc": "Вы прошли все рубежи легендарной пары!",
            "completed": True,
            "daysLeft": 0,
            "progressPct": 100.0
        }

    return {
        "years": max(0, y),
        "months": max(0, m),
        "days": max(0, d),
        "hours": max(0, h),
        "minutes": max(0, minute),
        "seconds": max(0, s),
        "totalDays": total_days,
        "totalHours": total_hours,
        "isFuture": is_future,
        "anniversaryTimestamp": start_ts,
        "anniversaryDateISO": start_dt.strftime("%Y-%m-%d"),
        "anniversaryFormatted": start_dt.strftime("%d.%m.%Y"),
        "nextMilestone": next_milestone,
        "milestones": milestones_list,
    }



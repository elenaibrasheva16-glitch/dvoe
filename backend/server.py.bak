def get_flame_stage_info(days_together: int, partner_left: bool = False) -> dict:
    days = max(1, int(days_together or 1))
    current_stage = FLAME_STAGES[0]
    for s in FLAME_STAGES:
        if days >= s["minDays"]:
            current_stage = s
        else:
            break

    next_stage = None
    curr_idx = FLAME_STAGES.index(current_stage)
    if curr_idx + 1 < len(FLAME_STAGES):
        next_stage = FLAME_STAGES[curr_idx + 1]

    days_in_tier = days - current_stage["minDays"]
    tier_span = (next_stage["minDays"] - current_stage["minDays"]) if next_stage else 1
    progress_pct = 100 if not next_stage else min(100, int((days_in_tier / max(1, tier_span)) * 100))
    days_to_next = (next_stage["minDays"] - days) if next_stage else 0

    return {
        "tier": current_stage["tier"],
        "id": current_stage["id"],
        "name": current_stage["name"],
        "title": current_stage["title"],
        "badge": current_stage["badge"],
        "desc": current_stage["desc"],
        "icon": current_stage["icon"],
        "color": current_stage["color"],
        "minDays": current_stage["minDays"],
        "nextDays": next_stage["minDays"] if next_stage else None,
        "nextName": next_stage["name"] if next_stage else None,
        "daysToNext": max(0, days_to_next),
        "progressPct": progress_pct,
        "isExtinguished": bool(partner_left),
    }


# =============================================================================
# EXACT CALENDAR MATH ENGINE (Years, Months, Days, Hours, Minutes, Seconds)
# Mathematically exact month-clamped advancement handling leap years & timezones
# =============================================================================
def is_leap_year(year: int) -> bool:
    return (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0)


def days_in_month(year: int, month: int) -> int:
    if month == 2:
        return 29 if is_leap_year(year) else 28
    if month in (4, 6, 9, 11):
        return 30
    return 31


def add_months_clamped(dt: datetime, months: int) -> datetime:
    total_months = dt.year * 12 + (dt.month - 1) + months
    target_year = total_months // 12
    target_month = (total_months % 12) + 1
    max_d = days_in_month(target_year, target_month)
    day = min(dt.day, max_d)
    return dt.replace(year=target_year, month=target_month, day=day)


